{
  "name": "opencode-muse-auth",
  "version": "0.5.2",
  "description": "Unofficial and experimental: Muse Spark in opencode using a Muse Code subscription credential, with a local loopback adapter for Meta's subscription wire format. May conflict with Meta's terms; use at your own risk. See DISCLAIMER.md.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Michael Gasperini",
    "url": "https://mikesoft.it"
  },
  "repository": "github:TheStreamCode/opencode-muse-auth",
  "homepage": "https://www.npmjs.com/package/opencode-muse-auth",
  "bugs": {
    "url": "https://github.com/TheStreamCode/opencode-muse-auth/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "meta",
    "muse",
    "muse-spark",
    "subscription",
    "oauth",
    "auth",
    "plugin"
  ],
  "files": [
    "index.js",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "DISCLAIMER.md",
    "AUTH_CONTRACT.md",
    "ADAPTER_CONTRACT.md"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 \"tests/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  }
}
